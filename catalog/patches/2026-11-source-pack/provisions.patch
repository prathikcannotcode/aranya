   "instruments": [
     { "id": "ngt-act-2010", "label": "National Green Tribunal Act, 2010", "citation": "Act 19 of 2010", "year": 2010, "in_force": true, "commencement": "18 October 2010", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Enacted 2 June 2010; in force 18 October 2010. Amended by the Finance Act 2017 and the Tribunals Reforms Act 2021 (per the India Code consolidated text)." },
     { "id": "epa-1986", "label": "Environment (Protection) Act, 1986", "citation": "Act 29 of 1986", "year": 1986, "in_force": true, "commencement": "19 November 1986", "source_url": "https://www.indiacode.nic.in/handle/123456789/13656", "verification": "source_cited", "note": "Enacted 23 May 1986. Parent statute for the EIA and CRZ notifications (s.3)." },
-    { "id": "eia-notif-2006", "label": "Environmental Impact Assessment Notification, 2006", "citation": "S.O. 1533(E), 14 September 2006, under EPA 1986", "year": 2006, "in_force": true, "source_url": "https://environmentclearance.nic.in/report/EIA_Notifications.aspx", "verification": "source_cited", "note": "The official MoEFCC listing opens with S.O. 1533(E) of 14 September 2006 and runs through amendments to S.O. 3372(E) of 26 July 2023. The draft EIA Notification 2020 (released 12 March 2020) was NOT notified and is not law; never cite the 2020 draft as operative. Re-check the listing for amendments after 2023." },
+    { "id": "eia-notif-2006", "label": "Environmental Impact Assessment Notification, 2006", "citation": "S.O. 1533(E), 14 September 2006, under EPA 1986", "year": 2006, "in_force": true, "source_url": "https://environmentclearance.nic.in/report/EIA_Notifications.aspx", "verification": "source_cited", "note": "The official MoEFCC listing opens with S.O. 1533(E) of 14 September 2006 and runs through amendments to S.O. 3372(E) of 26 July 2023; it still ended there on 2026-11-05. A Tamil Nadu PCB consolidation to March 2025 records later amendments, including S.O. 2115(E) of 7 June 2024, S.O. 523(E) of 29 January 2025 (items 8(a)/8(b): see credai-gc-2025) and S.O. 1223(E) of 17 March 2025; these were not opened at the Gazette. The draft EIA Notification 2020 (released 12 March 2020) was NOT notified and is not law; never cite the 2020 draft as operative." },
     { "id": "water-1974", "label": "Water (Prevention and Control of Pollution) Act, 1974", "citation": "Act 6 of 1974", "year": 1974, "in_force": true, "commencement": "23 March 1974", "source_url": "https://www.indiacode.nic.in/handle/123456789/15429", "verification": "source_cited" },
     { "id": "air-1981", "label": "Air (Prevention and Control of Pollution) Act, 1981", "citation": "Act 14 of 1981", "year": 1981, "in_force": true, "commencement": "29 March 1981", "source_url": "https://www.indiacode.nic.in/handle/123456789/9462", "verification": "source_cited" },
     { "id": "forest-1980", "label": "Forest (Conservation) Act, 1980", "citation": "Act 69 of 1980", "year": 1980, "in_force": true, "source_url": "https://www.indiacode.nic.in/handle/123456789/19381", "verification": "source_cited", "note": "Renamed Van (Sanrakshan Evam Samvardhan) Adhiniyam by the Forest (Conservation) Amendment Act 2023 (reported in force 1 December 2023 - single secondary source; confirm the commencement notification)." },
     { "id": "biodiv-2002", "label": "Biological Diversity Act, 2002", "citation": "Act 18 of 2003", "year": 2002, "in_force": true, "commencement": "assent 5 February 2003", "source_url": "https://www.indiacode.nic.in/handle/123456789/21545", "verification": "source_cited", "note": "Amended by the Biological Diversity (Amendment) Act 2023 (assent 3 August 2023), brought into force 1 April 2024 by Gazette notification." },
     { "id": "wildlife-1972", "label": "Wild Life (Protection) Act, 1972", "citation": "Act 53 of 1972", "year": 1972, "in_force": true, "commencement": "9 September 1972", "source_url": "https://www.indiacode.nic.in/handle/123456789/6198", "verification": "source_cited", "note": "NOT listed in NGT Schedule I: harm arising only under this Act may fall outside the NGT's jurisdiction. Confirmed against Schedule I of the NGT Act." },
-    { "id": "crz-notif-2019", "label": "Coastal Regulation Zone Notification, 2019", "citation": "G.S.R. 37(E), 18 January 2019, under EPA 1986 and the Environment (Protection) Rules 1986", "year": 2019, "in_force": true, "source_url": "https://www.keralaczma.gov.in/images/pdf/Notifications/CRZ%20Notification%202019%20with%20Amendments.pdf", "verification": "source_cited", "note": "Correct citation is G.S.R. 37(E) of 18 January 2019 - NOT S.O. 114(E), which was the 1991 CRZ notification. Supersedes the 2011 notification (S.O. 19(E)). Amended by S.O. 4886(E) of 26 Nov 2021 and S.O. 5495(E) of 24 Nov 2022; check for later amendments against the Gazette." }
+    { "id": "crz-notif-2019", "label": "Coastal Regulation Zone Notification, 2019", "citation": "G.S.R. 37(E), 18 January 2019, under EPA 1986 and the Environment (Protection) Rules 1986", "year": 2019, "in_force": true, "source_url": "https://www.keralaczma.gov.in/images/pdf/Notifications/CRZ%20Notification%202019%20with%20Amendments.pdf", "verification": "source_cited", "note": "Correct citation is G.S.R. 37(E) of 18 January 2019 - NOT S.O. 114(E), which was the 1991 CRZ notification. Supersedes the 2011 notification (S.O. 19(E)). Amended by S.O. 4886(E) of 26 Nov 2021 and S.O. 5495(E) of 24 Nov 2022; check for later amendments against the Gazette." },
+    { "id": "cpcb-ec-2019", "label": "CPCB In-house Committee report: Methodology for Assessing Environmental Compensation and Action Plan to Utilize the Fund", "citation": "Central Pollution Control Board, 2019 (date uncertain: see note)", "year": 2019, "summary": "Chapter I lists six instances: (a) discharges in violation of consent conditions; (b) non-compliance with directions; (c) intentional avoidance of data submission or tampering with online monitoring; (d) accidental discharges of short duration resulting in damage to the environment; (e) intentional discharges to land, water or air resulting in acute injury or damage; (f) injection of effluents into groundwater. For (a) to (c), EC = PI x N x R x S x LF: PI 80, 50 or 30 for red, orange or green sectors; N days of violation; R = Rs 250 (range 100 to 500); S 0.5, 1.0 or 1.5 by scale; LF 1.0 to 2.0 by city population, 2.0 for notified ecologically sensitive areas; minimum Rs 5,000 a day; multipliers for repeated or continuing violation (1.3.1). For (d) to (f), compensation has an immediate-relief part and a long-term remediation part, decided on detailed investigation by expert institutions, with a remediation plan supervised by SPCB, CPCB and the experts (1.3.2, 1.5.2). Where EC is assessed on actual damage, the amount is remediation costs, immediate and short-term measures and compensation towards loss of ecology, used only at the specific site (1.4.2). The formula applies only where CPCB has issued directions under the EPA (1.5.1). EC is not a substitute for action under the EPA, Water or Air Acts (1.5.4). Chapters II to IV cover GRAP violations, sewage and solid waste, and illegal groundwater extraction.", "source_url": "https://www.greentribunal.gov.in/sites/default/files/news_updates/Compliance%20Affidavit%20on%20behalf%20of%20R-1,%20with%20Report%20of%20the%20CPCB%20in%20house%20committee%20in%20E.A.No_.%2005-2021%20(page%20nos.%20241-287).pdf", "verification": "verify", "note": "Read on 2026-11-08 in the copy CPCB filed with the NGT (Western Zone) on 9 December 2021 in E.A. 05 of 2021 in O.A. 97 of 2019 (WZ), filing pp.245 to 254. The copy on cpcb.nic.in (uploads/report-15.07.2019.pdf) was unreachable: TLS certificate rejected. Official corroboration: the formula and clauses 1.5.1 to 1.5.4 are quoted in rhythm-county-2026 (paras 40, 41); the instances and notes match the December 2018 draft quoted in ngt-oa593-2019, which left LF for sensitive areas open and had no repeat multipliers. Date: Rhythm County (para 13.6) calls it the report dated 31.05.2019; secondary sources say 15 July 2019 and NGT acceptance on 28 August 2019; the acceptance order was not opened. Not statutory: 'facilitative and indicative, not prescriptive or exhaustive' (rhythm-county-2026, para 41). CPCB later issued a 'General framework for imposing environmental damage compensation' (December 2022), named in dpcc-lodhi-2025, para 35; not opened. For how REA/HEA sits against this, see hea." }
   ],
   "provisions": [
     { "id": "ngt-s14", "instrument_id": "ngt-act-2010", "section": "s.14", "label": "Tribunal to settle disputes", "summary": "Jurisdiction over all civil cases where a substantial question relating to the environment arises and the question arises out of the implementation of the enactments in Schedule I. An application must be made within six months of the date on which the cause of action first arose, extendable by up to sixty days for sufficient cause.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Six-month limitation (plus up to 60 days) confirmed against the Act text." },
-    { "id": "ngt-s15", "instrument_id": "ngt-act-2010", "section": "s.15", "label": "Relief, compensation and restitution", "summary": "The Tribunal may order (a) relief and compensation to victims of pollution and other environmental damage arising under the Schedule I enactments, (b) restitution of property damaged, and (c) restitution of the environment 'for such area or areas, as the Tribunal may think fit'. This relief is in addition to any relief under the Public Liability Insurance Act 1991.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Clause (c), restitution of the environment, is the statutory hook for restoration-scaled claims. Quoted verbatim from the Act." },
+    { "id": "ngt-s15", "instrument_id": "ngt-act-2010", "section": "s.15", "label": "Relief, compensation and restitution", "summary": "The Tribunal may order (a) relief and compensation to victims of pollution and other environmental damage arising under the Schedule I enactments, (b) restitution of property damaged, and (c) restitution of the environment 'for such area or areas, as the Tribunal may think fit'. This relief is in addition to any relief under the Public Liability Insurance Act 1991.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Clause (c), restitution of the environment, is the statutory hook for restoration-scaled claims. Quoted verbatim from the Act. Limitation for a s.15 application is in s.15(3): five years from when the cause for compensation or relief first arose (ngt-s15-3). The six months in s.14(3) is written for applications under s.14 (ngt-s14). Which period governs a given claim is for counsel: see catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q2." },
+    { "id": "ngt-s15-3", "instrument_id": "ngt-act-2010", "section": "s.15(3)", "label": "Limitation for compensation, relief and restitution", "summary": "No application for grant of any compensation or relief or restitution of property or environment under s.15 shall be entertained by the Tribunal unless it is made within a period of five years from the date on which the cause for such compensation or relief first arose. Proviso: if satisfied that the applicant was prevented by sufficient cause, the Tribunal may allow it to be filed within a further period not exceeding sixty days.", "source_url": "https://www.greentribunal.gov.in/sites/default/files/act_rules/National_Green_Tribunal_Act,_2010.pdf", "verification": "source_cited", "note": "Read on 2026-11-08 from the page image of the Gazette of India text of Act 19 of 2010 (Gazette p.6) as hosted by the NGT. India Code (handle 2025) returned HTTP 403, so the consolidated text was not compared; confirm on India Code that no later amendment touches s.15(3). Contrast s.14(3): six months from when the cause of action for the dispute first arose (ngt-s14). How 'first arose' applies to continuing or recurring harm is for counsel: catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q2." },
+    { "id": "ngt-s16", "instrument_id": "ngt-act-2010", "section": "s.16", "label": "Tribunal to have appellate jurisdiction", "summary": "Any person aggrieved by an order listed in clauses (a) to (j), made on or after the Act's commencement, may appeal to the Tribunal within a period of thirty days from the date on which the order or decision or direction or determination is communicated to him. Clause (h): an order granting environmental clearance in the area in which any industries, operations or processes shall not be carried out or shall be carried out subject to certain safeguards under the EPA 1986. Clause (i): an order refusing environmental clearance under the EPA 1986. The other clauses cover Water Act ss.28, 29 and 33A, Water Cess Act s.13, Forest (Conservation) Act s.2, Air Act s.31, EPA s.5 directions and Biological Diversity Act determinations. Proviso: a further period not exceeding sixty days for sufficient cause.", "source_url": "https://www.greentribunal.gov.in/sites/default/files/act_rules/National_Green_Tribunal_Act,_2010.pdf", "verification": "source_cited", "note": "Read on 2026-11-08 from the page image of the Gazette text as hosted by the NGT (Gazette p.7). Consolidated text on India Code not compared (HTTP 403). Section 18(2), second proviso (Gazette p.8), bars a person who has preferred a s.16 appeal from applying under s.18(2) for relief, compensation or settlement of dispute; read it before advising on both routes. When an EC counts as 'communicated' to a third party is for counsel: catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q3." },
     { "id": "ngt-s17", "instrument_id": "ngt-act-2010", "section": "s.17", "label": "Liability to pay relief or compensation", "summary": "Where death, injury, or damage to property or the environment results from an accident or the adverse impact of an activity, operation or process under a Schedule I enactment, the responsible person is liable to pay relief or compensation under the heads in Schedule II as the Tribunal determines; the Tribunal may apportion liability where it cannot be attributed to a single person.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited" },
     { "id": "ngt-s20", "instrument_id": "ngt-act-2010", "section": "s.20", "label": "Tribunal to apply certain principles", "summary": "The Tribunal shall, while passing any order, decision or award, apply the principles of sustainable development, the precautionary principle and the polluter pays principle.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Quoted from the Act text." },
     { "id": "ngt-schedule-1", "instrument_id": "ngt-act-2010", "section": "Schedule I", "label": "Scheduled enactments (seven)", "summary": "[See ss.14(1), 15(1), 17(1)(a), 17(2), 19(4)(j), 34(1)] The seven enactments: (1) Water (Prevention and Control of Pollution) Act 1974; (2) Water (Prevention and Control of Pollution) Cess Act 1977; (3) Forest (Conservation) Act 1980; (4) Air (Prevention and Control of Pollution) Act 1981; (5) Environment (Protection) Act 1986; (6) Public Liability Insurance Act 1991; (7) Biological Diversity Act 2002.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Enumeration confirmed verbatim against the Act. The Wild Life (Protection) Act 1972 is not in Schedule I." },
-    { "id": "ngt-schedule-2", "instrument_id": "ngt-act-2010", "section": "Schedule II", "label": "Heads of compensation and relief", "summary": "[See ss.15(4) and 17(1)] Heads under which compensation or relief may be claimed, including death, disability, loss of wages, medical expenses, damage to private property, government relief expenses, and head (g): expenses incurred by the Government for administrative or legal action or to cope with harm or damage, 'including compensation for environmental degradation and restoration of the quality of the environment', plus losses to government and harm to fauna.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "Head (g), covering restoration of the quality of the environment, is where a REA/HEA-scaled figure would sit. Quoted verbatim." },
+    { "id": "ngt-schedule-2", "instrument_id": "ngt-act-2010", "section": "Schedule II", "label": "Heads of compensation and relief", "summary": "[See ss.15(4) and 17(1)] Heads under which compensation or relief for damage may be claimed: (a) Death; (b) Permanent, temporary, total or partial disability or other injury or sickness; (c) Loss of wages due to total or partial disability or permanent or temporary disability; (d) Medical expenses incurred for treatment of injuries or sickness; (e) Damages to private property; (f) Expenses incurred by the Government or any local authority in providing relief, aid and rehabilitation to the affected persons; (g) Expenses incurred by the Government for any administrative or legal action or to cope with any harm or damage, including compensation for environmental degradation and restoration of the quality of environment; (h) Loss to the Government or local authority arising out of, or connected with, the activity causing any damage; (i) Claims on account of any harm, damage or destruction to the fauna including milch and draught animals and aquatic fauna; (j) Claims on account of any harm, damage or destruction to flora including aquatic flora, crops, vegetables, trees and orchards; (k) Claims including cost of restoration on account of any harm or damage to environment including pollution of soil, air, water, land and eco-systems; (l) Loss and destruction of any property other than private property; (m) Loss of business or employment or both; (n) Any other claim arising out of, or connected with, any activity of handling of hazardous substance.", "source_url": "https://www.indiacode.nic.in/handle/123456789/2025", "verification": "source_cited", "note": "All fourteen heads quoted verbatim; re-read on 2026-11-08 against the Gazette text of Act 19 of 2010 as hosted by the NGT (Gazette p.16). The earlier summary of this entry omitted heads (i) to (n), including (k). Which head a restoration-scaled figure belongs under, (g) or (k) or both, and whether head (g) is open to a private applicant, is undecided: see catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q1. Do not plead either head as settled." },
     { "id": "epa-s3", "instrument_id": "epa-1986", "section": "s.3", "label": "Power of Central Government to take measures", "summary": "The Central Government may take all such measures as it deems necessary or expedient to protect and improve the quality of the environment (s.3(1)); s.3(2) enumerates specific powers and s.3(3) allows constitution of authorities. This is the source of authority for the EIA Notification 2006 and the CRZ Notification.", "source_url": "https://www.indiacode.nic.in/handle/123456789/13656", "verification": "source_cited", "note": "General power confirmed; read s.3(1)-(3) for the specific sub-clause relied on in a given matter." },
-    { "id": "eia-2006-process", "instrument_id": "eia-notif-2006", "section": "para 7", "label": "EC appraisal stages", "summary": "Paragraph 7 provides four stages for prior environmental clearance: (1) Screening (only for Category B, to decide B1/B2), (2) Scoping (Terms of Reference), (3) Public Consultation (public hearing plus written responses), and (4) Appraisal by the Expert Appraisal Committee (Category A, MoEFCC) or State EAC (Category B, SEIAA), leading to grant or refusal with conditions. The stages are sequential and not all apply to every project.", "source_url": "https://environmentclearance.nic.in/report/EIA_Notifications.aspx", "verification": "source_cited", "note": "Four-stage structure of para 7 confirmed. Separately verify: the Supreme Court in Vanashakti v. Union of India (2025) is reported to have restricted post-facto environmental clearances; confirm before advising on ex post facto ECs." }
+    { "id": "eia-2006-process", "instrument_id": "eia-notif-2006", "section": "para 7", "label": "EC appraisal stages", "summary": "Paragraph 7 provides four stages for prior environmental clearance: (1) Screening (only for Category B, to decide B1/B2), (2) Scoping (Terms of Reference), (3) Public Consultation (public hearing plus written responses), and (4) Appraisal by the Expert Appraisal Committee (Category A, MoEFCC) or State EAC (Category B, SEIAA), leading to grant or refusal with conditions. The stages are sequential and not all apply to every project.", "source_url": "https://environmentclearance.nic.in/report/EIA_Notifications.aspx", "verification": "source_cited", "note": "Four-stage structure of para 7 confirmed. Ex post facto EC: Vanashakti-I (2025), which barred it, was recalled on review (credai-vanashakti-2025) and the matter was decided afresh in vanashakti-2026; read that entry before advising on post facto ECs. Obligations after grant sit in para 10 (eia-2006-para-10) and the EC's own conditions, not in para 7." },
+    { "id": "eia-2006-gc", "instrument_id": "eia-notif-2006", "section": "Schedule, Note: General Condition (GC)", "label": "General Condition: Category B appraised at the Central level", "summary": "Any project or activity specified in Category 'B' will be appraised at the Central level as Category 'A' if located in whole or in part within 5 km from the boundary of: (i) Protected areas notified under the Wild Life (Protection) Act 1972; (ii) Critically polluted areas identified by the CPCB from time to time; (iii) Eco-sensitive areas notified under s.3(2) of the EPA 1986; (iv) inter-State and international boundaries. For river valley projects (item 1(c)), thermal power plants (1(d)), industrial estates, parks, EPZs, SEZs, biotech parks and leather complexes (7(c)) and common TSDFs (7(d)), appraisal is at the Central level even if located within 10 km. The inter-State boundary distance may be reduced or removed by agreement between the States or Union Territories if the activity is not within the distance of items (i) to (iii). The GC applies only to items whose column 5 says so; it does not apply to items 8(a) and 8(b).", "source_url": "https://environmentclearance.nic.in/writereaddata/EIA_Notifications/15_SO1599_E_25062014.pdf", "verification": "source_cited", "note": "Text as substituted by S.O. 1599(E) of 25 June 2014, read on 2026-11-05 in the Gazette copy on the MoEFCC listing (Gazette p.10). Earlier wording (S.O. 3067(E) of 1 December 2009) not checked; do not rely on a recollected 10 km rule for protected areas. Items 8(a)/8(b): S.O. 523(E) of 29 January 2025 states General Conditions shall not apply; the Supreme Court upheld it on 5 August 2025 in W.P.(C) 166 of 2025, except Note 1 to entry 8(a), as recorded in credai-gc-2025. Neither S.O. 523(E) nor that order was opened. Amendments after March 2025 not checked." },
+    { "id": "eia-2006-para-8-vi", "instrument_id": "eia-notif-2006", "section": "para 8(vi)", "label": "Concealment or false information", "summary": "Deliberate concealment and/or submission of false or misleading information or data which is material to screening or scoping or appraisal or decision on the application shall make the application liable for rejection, and cancellation of prior environmental clearance granted on that basis. Rejection of an application or cancellation of a prior environmental clearance already granted, on such ground, shall be decided by the regulatory authority, after giving a personal hearing to the applicant, and following the principles of natural justice.", "source_url": "https://environmentclearance.nic.in/writereaddata/EIA_Notifications/1_SO1533E_14092006.pdf", "verification": "source_cited", "note": "Read on 2026-11-08 from the page image of S.O. 1533(E) as listed by MoEFCC (Gazette p.42). The Tamil Nadu PCB consolidation to March 2025 shows the same words with no amendment footnote. Cancellation on this ground is for the regulatory authority after a hearing; whether the NGT may itself set an EC aside on this ground is for counsel: catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q4." },
+    { "id": "eia-2006-appendix-iv", "instrument_id": "eia-notif-2006", "section": "Appendix IV", "label": "Procedure for conduct of public hearing", "summary": "Public hearing at or near the site, district-wise, by the SPCB or UTPCC (1.0). The applicant sends at least 10 hard and equal soft copies of the draft EIA report, including the Summary EIA report in English and in the official language of the State/local language, and copies go to the District Magistrate, Zila Parishad or Municipal Corporation, District Industries Office, ULBs/PRIs and the MoEF Regional Office (2.2), which publicise it and make it available for inspection (2.3, 2.4). The Member-Secretary fixes date, time and venue within 7 days of receiving the draft EIA report and advertises in one major National Daily and one Regional vernacular Daily/Official State Language; a minimum notice period of 30 days is given for responses (3.1). Where newspapers do not reach, other means such as beating of drums, radio or television (3.2). No postponement unless an untoward emergency, on the District Magistrate recommendation (3.3); a rescheduled hearing is at least 45 days from the first advertisement, with at least 15 days of notice before the new date (3.3(a)).", "source_url": "https://environmentclearance.nic.in/writereaddata/EIA_Notifications/4_SO3067E_01122009.pdf", "verification": "source_cited", "note": "Appendix IV as substituted by S.O. 3067(E) of 1 December 2009 (paras 1.0 to 3.3 read on 2026-11-05 in the Gazette copy on the MoEFCC listing) and para 3.3(a) as inserted by S.O. 2163(E) of 9 May 2022 (read in its Gazette copy). Paras 4.0 to 7.1 (presiding officer, videography, minutes in the local language, completion in 45 days) and the proviso to 4.0 allowing a Sub-Divisional Magistrate were read only in the Tamil Nadu PCB consolidation and are not summarised here. Whether a defect in the hearing vitiates the EC is for counsel: catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q5." },
+    { "id": "eia-2006-para-10", "instrument_id": "eia-notif-2006", "section": "para 10", "label": "Post environmental clearance monitoring", "summary": "(i) Category A: the project proponent makes the EC public with its conditions and safeguards by advertising it in at least two local newspapers and displaying it permanently on its website; Category B: the proponent advertises that EC has been accorded with details of the MoEF website where it is displayed; MoEF and SEIAAs place the EC on a Government portal; copies go to heads of local bodies, Panchayats and Municipal Bodies and relevant Government offices, which display them for 30 days from receipt. (ii) The project management must submit half-yearly compliance reports on the stipulated EC terms and conditions, in soft copy, to the regulatory authority on 1 June and 1 December of each calendar year. (iii) All such compliance reports are public documents; copies are given to any person on application, and the latest is displayed on the website of the regulatory authority.", "source_url": "https://environmentclearance.nic.in/writereaddata/EIA_Notifications/4_SO3067E_01122009.pdf", "verification": "source_cited", "note": "Assembled from Gazette texts read on 2026-11-05 and 2026-11-08: S.O. 1533(E), Gazette p.43 (original paras 10(i) and (ii)); S.O. 3067(E) of 1 December 2009, item IV (new sub-para (i), renumbering); S.O. 5845(E) of 26 November 2018 (hard and soft copies replaced by soft copy). The consolidation also shows DEIAAs added and a sub-para (iv) on sand mining by S.O. 141(E) of 15 January 2016, which it records as suspended by the NGT; neither checked at the Gazette. Para 10 governs publicity and compliance reporting; it does not itself state the consequence of breaching an EC condition. That turns on the terms of the EC and the EPA 1986 (s.15 as substituted by the Jan Vishwas Act 2023, not in this catalog)." }
   ],
   "doctrines": [
     { "id": "polluter-pays", "label": "Polluter pays principle", "summary": "The polluter bears the cost of both compensation to victims and restoration of the degraded environment; part of Indian environmental law and expressly directed by NGT Act s.20.", "source_url": "https://indiankanoon.org/doc/1934103/", "verification": "source_cited", "note": "Leading authorities: Vellore Citizens (1996) 5 SCC 647 and Indian Council for Enviro-Legal Action (1996) 3 SCC 212." },
@@ -31,10 +38,21 @@
   "cases": [
     { "id": "vellore-1996", "label": "Vellore Citizens' Welfare Forum v. Union of India", "citation": "(1996) 5 SCC 647", "principle": "Precautionary and polluter pays principles are part of Indian environmental law; sustainable development adopted.", "source_url": "https://indiankanoon.org/doc/1934103/", "verification": "source_cited", "note": "Decided 28 August 1996 (Kuldip Singh and K. Venkataswami JJ.); also AIR 1996 SC 2715. Concerned pollution of the river Palar by Vellore tanneries. Confirm pinpoints against the SCC report." },
     { "id": "icela-1996", "label": "Indian Council for Enviro-Legal Action v. Union of India", "citation": "(1996) 3 SCC 212", "principle": "Absolute liability of an enterprise carrying on a hazardous activity; polluter pays for remediation of the affected area (Bichhri).", "source_url": "https://indiankanoon.org/doc/1818014/", "verification": "source_cited", "note": "Decided 13 February 1996 (B.P. Jeevan Reddy J.); also AIR 1996 SC 1446. Confirm specific paragraph pinpoints against the SCC report before relying on them." },
-    { "id": "mc-mehta-kamal-nath-1997", "label": "M.C. Mehta v. Kamal Nath", "citation": "(1997) 1 SCC 388", "principle": "Public trust doctrine is part of the law of India; the polluter must bear the cost of reversing the ecological damage caused.", "source_url": "https://indiankanoon.org/doc/1239689/", "verification": "source_cited", "note": "Decided 13 December 1996 (Kuldip Singh and S. Saghir Ahmad JJ.); Span Motel on the river Beas. doc/1239689 is the Supreme Court's 2002 order in the same petition restating the 1997 holding; confirm paragraph pinpoints against (1997) 1 SCC 388." }
+    { "id": "mc-mehta-kamal-nath-1997", "label": "M.C. Mehta v. Kamal Nath", "citation": "(1997) 1 SCC 388", "principle": "Public trust doctrine is part of the law of India; the polluter must bear the cost of reversing the ecological damage caused.", "source_url": "https://indiankanoon.org/doc/1239689/", "verification": "source_cited", "note": "Decided 13 December 1996 (Kuldip Singh and S. Saghir Ahmad JJ.); Span Motel on the river Beas. doc/1239689 is the Supreme Court's 2002 order in the same petition restating the 1997 holding; confirm paragraph pinpoints against (1997) 1 SCC 388." },
+    { "id": "ngt-oa593-2019", "label": "Paryavaran Suraksha Samiti v. Union of India (NGT order of 19 February 2019)", "citation": "NGT Principal Bench, O.A. No. 593/2017 (arising from W.P.(C) 375/2012), order dated 19.02.2019", "principle": "Recorded the December 2018 CPCB methodology for environmental compensation (PI x N x R x S x LF for consent and direction violations; detailed investigation by expert institutions for damage cases) and asked CPCB to also cover 'loss to ecological services due to illegal mining, due to deforestation or any other damage to the environment', taking inputs from bodies such as IEG, CSE, TERI and IIFM Bhopal (paras 6 to 9).", "source_url": "https://pcbassam.org/court%20cases/NGT/593_2017/NGT%20Order%20-19.2.2019%20compensation%20593_2017.pdf", "verification": "verify", "note": "Read on 2026-11-05 in the copy hosted by the Pollution Control Board, Assam, not on greentribunal.gov.in. Coram: Adarsh Kumar Goel (Chairperson), S.P. Wangdi, K. Ramakrishnan, Dr Nagin Nanda. The proceedings follow the Supreme Court order of 22 February 2017 in Paryavaran Suraksha Samiti v. Union of India, (2017) 5 SCC 326 (not opened). The later order said to accept the CPCB report (28 August 2019) was not opened." },
+    { "id": "vanashakti-2025", "label": "Vanashakti v. Union of India (Vanashakti-I)", "citation": "2025 INSC 718, W.P.(C) 1394 of 2023, decided 16 May 2025 (Oka and Bhuyan JJ.)", "principle": "RECALLED on 18 November 2025 (credai-vanashakti-2025) and the matter decided afresh in vanashakti-2026. Not good law; do not cite for any proposition. It had struck down the 2017 Notification and the 2021 OM on ex post facto EC and restrained the Centre from issuing any such instrument, leaving ECs already granted unaffected (paras 35, 36).", "source_url": "https://api.sci.gov.in/supremecourt/2023/50009/50009_2023_3_1502_61809_Judgement_16-May-2025.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05. Kept so that a run meeting this citation, or a brief describing it as restricting post facto clearances, resolves it to its current status." },
+    { "id": "credai-vanashakti-2025", "label": "Confederation of Real Estate Developers of India (CREDAI) v. Vanashakti (review)", "citation": "2025 INSC 1326, R.P.(C) Diary No. 41929 of 2025 in W.P.(C) 1394 of 2023, decided 18 November 2025 (Gavai CJI; Chandran J. concurring; Bhuyan J. dissenting)", "principle": "By 2:1 the review was allowed, Vanashakti-I recalled and the writ petitions and appeal restored to file (Gavai CJI, paras 141 to 143). Chandran J. concurred that review was warranted and did not decide the validity of the 2017 Notification. Bhuyan J. would have dismissed the review (para 58). The bench that reheard the matter held that the ratio of the review order goes no further than the two grounds of recall (vanashakti-2026, para 21).", "source_url": "https://api.sci.gov.in/supremecourt/2025/41929/41929_2025_1_1501_66095_Judgement_18-Nov-2025.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05: operative paragraphs, the opinion of Chandran J. and paras 55 to 58 of the dissent read directly; the reasoning of the lead opinion read in part and through the account in vanashakti-2026, paras 13 to 21. Superseded on the merits by vanashakti-2026; cite it only for the recall." },
+    { "id": "vanashakti-2026", "label": "Vanashakti v. Union of India (rehearing after recall)", "citation": "2026 INSC 761, W.P.(C) 1394 of 2023 and connected matters, decided 29 July 2026 (Surya Kant CJI, Joymalya Bagchi and Vipul M. Pancholi JJ.)", "principle": "The prior EC regime under the 2006 Notification is mandatory and, unless amended by an appropriate notification, does not accommodate post facto EC or retention of projects begun without a valid EC. The Centre may issue a narrowly tailored, time-bound amnesty notification under EPA s.3 in supervening public interest; the 2017 Notification is valid on that footing. The 2021 OM, an administrative order creating a perpetual regime, is quashed with prospective effect. ECs already granted under either instrument stay valid unless individually challenged; pending applications go to their logical conclusion; no fresh applications; no future post facto EC by administrative order. The Article 142 power of the Court is unaffected. The reading in Electrosteel that the Act and Notification accommodate post facto EC is disapproved; Pahwa and D. Swamy are overruled so far as they treat the 2021 OM as valid (paras 79 to 81).", "source_url": "https://api.sci.gov.in/supremecourt/2023/50009/50009_2023_1_1501_72722_Judgement_29-Jul-2026.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05; operative part identical to the SCObserver copy also read. On compensation: an amnesty must subject violators to damage assessment, remediation and compensatory liability (paras 39, 54, 61 to 64); 'some environmental injuries cannot be compensated in money' (para 57); the 2017 Notification requires ecological damage assessment and remediation and resource augmentation plans by a laboratory notified under the EPA, accredited by NABL or belonging to a CSIR institution, with no cap on compensation (para 62); the 2021 OM had fixed compensation at 1% of project cost plus 0.25% of turnover in the violation period (para 67). An MoEFCC OM of 20 January 2026 (para 77) had directed pending applications to be processed subject to further orders; a later MoEFCC direction (reported October 2026) was not opened. No review of this judgment found as at 2026-11-08 (search only)." },
+    { "id": "credai-gc-2025", "label": "CREDAI v. Union of India (General Conditions and items 8(a), 8(b))", "citation": "2025 INSC 1112, C.A. 10043 of 2024 with C.A. 5532 of 2025, decided 12 September 2025 (Pardiwala and Mahadevan JJ.)", "principle": "Disposed of appeals against the NGT order of 9 August 2024 (building and construction projects within 5 km of the GC areas to be treated as Category A) in the light of the coordinate bench order of 5 August 2025 in W.P.(C) 166 of 2025: the General Conditions were never attracted to items 8(a) and 8(b); S.O. 523(E) of 29 January 2025 and the OM of 30 January 2025 upheld except Note 1 to entry 8(a), which was quashed; SEIAA, an expert body, appraises such projects. The 2025 Notification, excluding Note 1 to entry 8(a), holds the field (paras 23 to 25).", "source_url": "https://api.sci.gov.in/supremecourt/2024/38099/38099_2024_8_1508_64231_Judgement_12-Sep-2025.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05. The 5 August 2025 order (listed on Indian Kanoon as Vanashakti v. Union of India, W.P.(C) 166 of 2025, Gavai CJI; a different matter from the post facto EC cases) was not read beyond its caption; its holding is taken from paras 22 to 24 here." },
+    { "id": "rhythm-county-2026", "label": "M/s Rhythm County v. Satish Sanjay Hegde", "citation": "2026 INSC 102, C.A. 7187 of 2022 with C.A. 7974 of 2022 (Key Stone Properties), decided 30 January 2026 (Dipankar Datta and Vijay Bishnoi JJ.)", "principle": "NGT Act ss.15, 17 and 20 let the NGT quantify environmental compensation without a legislated formula (paras 19 to 25). Turnover or project cost may be a relevant yardstick where the facts warrant, but not a blunt instrument; compensation must be rational, proportionate and reasoned (paras 32, 39, 46.2). The 5% of project cost in goel-ganga-2018 is a general guide, not a ceiling (para 45). The CPCB methodology is facilitative and indicative, not prescriptive: its formula is confined to limited categories of violation arising from directions under the EPA, and other cases call for 'a detailed, site-specific and expert-driven assessment with emphasis on remediation and restitution' (paras 40, 41, 46.4). The NGT may still use the CPCB framework and expert committees if it applies its own mind (paras 42 to 44). Both NGT awards upheld.", "source_url": "https://api.sci.gov.in/supremecourt/2022/30735/30735_2022_8_1501_67798_Judgement_30-Jan-2026.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05. Reads Benzo Chem Industrial (P) Ltd. v. Arvind Manohar Mahajan (C.A. 9202-9203 of 2022) and cl-gupta-2025 as turning on conjecture, lack of notice and lack of nexus, not a bar on turnover (paras 35 to 38). Relies on Deepak Nitrite Ltd. v. State of Gujarat, (2004) 6 SCC 402, para 6, and Research Foundation for Science (18) v. Union of India, (2005) 13 SCC 186, para 30, both quoted, not opened. The Keystone figure was the CPCB formula, 50 x 1909 x 250 x 1.5 x 1.25 (para 43)." },
+    { "id": "cl-gupta-2025", "label": "M/s C.L. Gupta Export Ltd. v. Adil Ansari", "citation": "2025 INSC 1035, C.A. 2864 of 2022, decided 22 August 2025 (Gavai CJI and K. Vinod Chandran J.)", "principle": "Set aside the Rs 50 crore compensation the NGT fixed on turnover, for want of nexus between turnover and the pollution alleged; if the NGT thought the EC imposed too low it 'could have referred to the methodology framed by the CPCB and not merely looked at the revenue generation of the alleged polluter' (para 11). The audit, monitoring and restoration directions of the NGT stand (paras 9, 13). The NGT cannot direct prosecution under the PMLA (para 12).", "source_url": "https://api.sci.gov.in/supremecourt/2022/10809/10809_2022_10_1501_63545_Judgement_22-Aug-2025.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05. Read down by rhythm-county-2026 (paras 37, 38) as not barring turnover as a factor." },
+    { "id": "dpcc-lodhi-2025", "label": "Delhi Pollution Control Committee v. Lodhi Property Co. Ltd.", "citation": "2025 INSC 923, C.A. 757-760 of 2013 with C.A. 1977-2011 of 2013, decided 4 August 2025 (P.S. Narasimha and Manoj Misra JJ.)", "principle": "Pollution Control Boards may impose and collect restitutionary and compensatory damages as fixed sums, or require bank guarantees as an ex ante measure, under Water Act s.33A and Air Act s.31A (para 39(b)), on a determination that environmental damage has been caused or is imminent (para 30). Rules and regulations must set out the methods by which damage is determined and quantum assessed, with natural justice; the CPCB document 'General framework for imposing environmental damage compensation' (December 2022) should be reviewed and issued as rules (para 35). The power is to be enforced only after such subordinate legislation (para 39(c)); see dpcc-lodhi-2026-order.", "source_url": "https://api.sci.gov.in/supremecourt/2012/40604/40604_2012_6_1501_62921_Judgement_04-Aug-2025.pdf", "verification": "source_cited", "note": "Official PDF read on 2026-11-05 (paras 35 to 39 directly; para 30 as quoted in the NGT order cited in dpcc-lodhi-2026-order). Concerns Boards under the Water and Air Acts, not the NGT under NGT Act ss.15 and 17; rhythm-county-2026 records it only as argued (para 13.13)." },
+    { "id": "dpcc-lodhi-2026-order", "label": "Delhi Pollution Control Committee v. Lodhi Property Co. Ltd. (clarifying order)", "citation": "Supreme Court order dated 21 May 2026 in C.A. 757-760 of 2013", "principle": "As quoted: the 4 August 2025 directions 'should not be understood to mean that the regulators, being the Pollution Control Boards cannot proceed to impose and collect the compensatory environmental damages in the absence of subordinate legislation, on the subject' (para 2).", "source_url": "https://indiankanoon.org/doc/29536194/", "verification": "unverified", "note": "Not opened at source. Read only as quoted in the NGT order of 27 August 2026 in O.A. 1025 of 2024, Surender Singh Parihar v. State of U.P., paras 81 to 84, on Indian Kanoon. A press report of 21 May 2026 describes the Supreme Court as saying Boards cannot levy compensation without rules, the opposite of the quoted text. Pull the order from sci.gov.in before relying on either." },
+    { "id": "amravati-2026", "label": "Amravati Municipal Corporation v. Ganesh Dadarao Anasane", "citation": "2026 INSC 796, C.A. 4020 of 2020 with C.A. 8630 of 2022, judgment of 4 August 2026 (P.S. Narasimha and Alok Aradhe JJ.)", "principle": "Directing MoEFCC to frame environmental compensation guidelines under Rule 17(2) of the Solid Waste Management Rules 2026, the Court stated eight principles (para 17): compensation is restitutionary and additional to penalty; liability lasts until the damage is reversed; authorities must value the damage and collect what restoration requires; tangible and intangible damage both count; imminent or potential harm suffices; the capacity of the polluter, the cost of assessment, the loss to individuals and the environment and the cost of remediation or restoration are factors; compensation must be proportional with a rational nexus to the pollution; courts and tribunals must record reasons, listing the factors considered, the valuation standard used and the formula or guidelines applied.", "source_url": "https://www.verdictum.in/pdf_upload/2026/08/05/amaravati-municipal-corporation-v-ganesh-dadarao-1782037.pdf", "verification": "verify", "note": "Read on 2026-11-05 in a Verdictum-hosted copy of the judgment; the sci.gov.in copy was not found. The principles are stated for guidelines under the SWM Rules; whether they bind NGT quantification under ss.15 and 17 is for counsel. Listed again on 29 September 2026; later orders not checked." },
+    { "id": "goel-ganga-2018", "label": "Goel Ganga Developers India Pvt. Ltd. v. Union of India", "citation": "(2018) 18 SCC 257", "principle": "For an intransigent violator the Court fixed damages at Rs 100 crore or 10% of project cost, whichever is more, after observing that it 'has in a number of cases awarded 5% of the project cost as damages. This is the general law' (para 64, as quoted).", "source_url": "https://api.sci.gov.in/supremecourt/2022/30735/30735_2022_8_1501_67798_Judgement_30-Jan-2026.pdf", "verification": "verify", "note": "Not opened. Para 64 read only as quoted in rhythm-county-2026, para 28 (the source_url), which treats 5% as a general guide, not a ceiling (para 45). Confirm the paragraph against the SCC report." }
   ],
   "methodologies": [
-    { "id": "hea", "label": "Habitat Equivalency Analysis (HEA)", "summary": "Sizes compensatory restoration by equating the discounted flow of habitat services lost through injury with the discounted service gains of a restoration project (discounted service-acre-years). Used in U.S. natural resource damage assessment under CERCLA/OPA.", "methodology_status": "novel_persuasive", "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7007898/", "verification": "source_cited", "note": "No documented NGT or Indian court use. Present only as a persuasive comparative methodology via foreign-authority-handler; the restoration-cost output sits under NGT s.15/s.17 and Schedule II head (g), which is a novel argument in India." },
-    { "id": "rea", "label": "Resource Equivalency Analysis (REA)", "summary": "Variant of equivalency analysis that scales restoration against a specific resource service (for example fisheries production or recreational use) rather than habitat area. Distinct from HEA; the choice of method is itself part of the expert argument.", "methodology_status": "novel_persuasive", "source_url": "https://www.sciencedirect.com/science/article/abs/pii/S0921800903002519", "verification": "source_cited", "note": "No documented NGT or Indian court use. Keep distinct from HEA in any filing." }
+    { "id": "hea", "label": "Habitat Equivalency Analysis (HEA)", "summary": "Sizes compensatory restoration by equating the discounted flow of habitat services lost through injury with the discounted service gains of a restoration project (discounted service-acre-years). Used in U.S. natural resource damage assessment under CERCLA/OPA.", "methodology_status": "novel_persuasive", "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7007898/", "verification": "source_cited", "note": "No documented NGT or Indian court use found (searches to 2026-11-08; a negative search, not proof of absence). Present only as a persuasive comparative methodology via foreign-authority-handler. Statutory hook: s.15(1)(c) and s.17, with a Schedule II head that counsel must choose, (g) or (k) (catalog/patches/2026-11-source-pack/QUESTIONS-FOR-COUNSEL.md, Q1). The Indian slot for it is the damage track of the CPCB methodology: where compensation is decided on detailed investigation by expert institutions, the amount is remediation costs, immediate and short-term measures and 'compensation towards loss of ecology', used at the specific site (cpcb-ec-2019, clauses 1.3.2, 1.4.2, 1.5.2). The Supreme Court reads that track as 'a detailed, site-specific and expert-driven assessment with emphasis on remediation and restitution' (rhythm-county-2026, para 46.4), and courts must record the valuation standard and formula used (amravati-2026, para 17(VIII)). REA/HEA sizes restoration only; it does not measure deterrence, gain or the scale of the enterprise, which the courts also weigh (rhythm-county-2026, goel-ganga-2018). Present it as the expert assessment on the damage track, never as a replacement for the CPCB formula on consent or direction violations." },
+    { "id": "rea", "label": "Resource Equivalency Analysis (REA)", "summary": "Variant of equivalency analysis that scales restoration against a specific resource service (for example fisheries production or recreational use) rather than habitat area. Distinct from HEA; the choice of method is itself part of the expert argument.", "methodology_status": "novel_persuasive", "source_url": "https://www.sciencedirect.com/science/article/abs/pii/S0921800903002519", "verification": "source_cited", "note": "No documented NGT or Indian court use. Keep distinct from HEA in any filing. Positioned against the CPCB methodology and the Supreme Court's compensation cases as in the hea entry." }
   ]
 }
