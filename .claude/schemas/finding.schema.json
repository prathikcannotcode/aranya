{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis finding",
  "description": "One analysis point, tied to a clause: cite the provision, state severity, give a recommendation, and carry a verification state. `catalog_id` must name an entry in catalog/provisions.json, and `source_url` and `verification` must match it.",
  "type": "object",
  "required": ["finding_id", "summary", "instrument", "provision", "severity", "recommendation", "source_url", "verification", "catalog_id"],
  "properties": {
    "finding_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "instrument": { "type": "string", "minLength": 1 },
    "provision": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "recommendation": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "verification": { "type": "string", "enum": ["source_cited", "verify", "unverified"] },
    "flag_id": { "type": "string" },
    "catalog_id": { "type": "string" }
  },
  "additionalProperties": true
}
