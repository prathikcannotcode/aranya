{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REA/HEA injury and restoration parameters",
  "description": "Inputs to the equivalency calculator. Areas in hectares; service levels as a fraction of baseline (0..1). Every value is an expert input, not a lookup; vary the contested ones with the sensitivity range.",
  "type": "object",
  "required": ["method", "injured_area", "baseline_service", "injured_service", "injury_years", "recovery_years", "restoration_gain", "restoration_years", "discount_rate"],
  "properties": {
    "method": { "type": "string", "enum": ["HEA", "REA"] },
    "label": { "type": "string" },
    "injured_area": { "type": "number", "minimum": 0 },
    "baseline_service": { "type": "number", "minimum": 0, "maximum": 1 },
    "injured_service": { "type": "number", "minimum": 0, "maximum": 1 },
    "injury_years": { "type": "integer", "minimum": 0 },
    "recovery_years": { "type": "integer", "minimum": 0 },
    "restoration_gain": { "type": "number", "minimum": 0, "maximum": 1 },
    "restoration_years": { "type": "integer", "minimum": 1 },
    "restoration_lag": { "type": "integer", "minimum": 0, "description": "Years from the start of the injury (t = 0) until restoration begins delivering service" },
    "discount_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "As a fraction: 0.03 means 3%" },
    "restoration_unit_cost": { "type": "number", "minimum": 0, "description": "Cost per hectare of restoration" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code for restoration_unit_cost, e.g. INR" },
    "sensitivity_pct": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
